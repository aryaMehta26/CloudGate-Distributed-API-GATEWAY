# CloudGate environment variable reference
# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# ── Server ────────────────────────────────────────────────────────────────────
CLOUDGATE_SERVER_ADDR=:8080
CLOUDGATE_SERVER_METRICS_ADDR=:9090

# ── Redis ─────────────────────────────────────────────────────────────────────
# Comma-separated for cluster mode
CLOUDGATE_REDIS_ADDRS=localhost:6379
CLOUDGATE_REDIS_PASSWORD=
CLOUDGATE_REDIS_DB=0

# ── Cassandra ─────────────────────────────────────────────────────────────────
CLOUDGATE_CASSANDRA_HOSTS=localhost
CLOUDGATE_CASSANDRA_KEYSPACE=cloudgate
CLOUDGATE_CASSANDRA_USERNAME=
CLOUDGATE_CASSANDRA_PASSWORD=

# ── Admin gRPC ────────────────────────────────────────────────────────────────
CLOUDGATE_ADMIN_GRPC_ADDR=:50051
